{
  "name": "apps-site",
  "version": "0.1.0",
  "private": true,
  "description": "A static app directory built from repository-local JSON and standalone catalogues.",
  "type": "module",
  "license": "Unlicense",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "build": "node bin/apps-site.mjs build",
    "validate": "node bin/apps-site.mjs check",
    "preview": "node bin/apps-site.mjs preview",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": { "ajv": "^8.17.1", "proper-lockfile": "^4.1.2", "sharp": "^0.35.5" },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "globals": "^17.3.0"
  }
}
